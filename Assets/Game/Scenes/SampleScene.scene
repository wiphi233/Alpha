--- !u!114 &1013146820
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1013146818}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "  \u611F\u8C22\u60A8\u6E38\u73A9 Alpha OS\uFF0C\u8FD9\u662F\u4E00\u4E2A\u7531
    WiPhi233_awa \u5F00\u53D1\u7684\u72EC\u7ACB\u6E38\u620F\u3002\r\n    \u6574\u4E2A\u6E38\u620F\u7684\u51E0\u4E4E\u6240\u6709\u5185\u5BB9\uFF08\u5305\u62EC\u7B56\u5212\u3001\u7A0B\u5E8F\u3001\u7F8E\u672F\u3001\u97F3\u9891\u3001\u6D4B\u8BD5\u4E0E\u8FD0\u8425\u7B49\uFF09\u90FD\u4E00\u4E2A\u4EBA\u4ECE\u96F6\u5F00\u59CB\u5B8C\u6210\uFF0C\u5C0F\u5B66\u516D\u5E74\u7EA7\uFF082026
    \u5E74 2 \u6708 22 \u65E5\uFF09\u5F00\u59CB\u521B\u4F5C\uFF0C\u4F5C\u8005\u7F8E\u672F\uFF08\u5EFA\u6A21\u3001\u97F3\u6548\u3001\u5404\u79CD\u56FE\u7247\u7B49\uFF09\u505A\u5F97\u5F88\u5DEE\uFF0C\u6BD5\u7ADF\u8FD9\u5F00\u59CB\u65F6\u4E5F\u4EC5\u4EC5\u662F\u4E2A
    demo\u3002\r\n    \u5982\u679C\u4F60\u6709\u80FD\u529B\uFF0C\u6B22\u8FCE\u5411\u6211\u4EEC\u6350\u8D60\u6216\u52A0\u5165\u5F00\u53D1\uFF0C\u76EE\u6807\u6210\u4E3A\u4E00\u4E2A\u5546\u4E1A\u9879\u76EE\u3002\r\n\r\n   
    <i>\u4E0D\u9519\u7684\u6E38\u620F\uFF0C\u5267\u60C5\u548C\u73A9\u6CD5\u76F8\u4E92\u547C\u5E94\uFF0C\u58F0\u5149\u4EA4\u878D\uFF0C\u6307\u5C16\u7075\u52A8\u3002\u5373\u4F7F\u662F\u6211\uFF0C\u4E5F\u611F\u5230\u5FC3\u6F6E\u6F8E\u6E43\u3002</i>\r\n\r\n   
    \u300C\u6211\u5E38\u5E38\u8FFD\u5FC6\u8FC7\u53BB\u3002\u300D\r\n\r\n    \u300C\u4ECE\u6211\u642D\u51FA\u4E86\u7B2C\u4E00\u5757\u79EF\u6728\u5F00\u59CB\uFF0C\u300D\r\n\r\n   
    \u300C\u4EFF\u4F5B\u8E0F\u8FDB\u4E86\u65B0\u4E16\u754C\u7684\u5927\u95E8\u3002\u300D\r\n\r\n   
    <i>O Fortuna, velut luna statu variabilis.\r\n            \u2014\u2014\u5E03\u5170\u8BD7\u6B4C</i>\r\n\r\n   
    \u300C\u6211\u7528 Python \u5411\u4E16\u754C\u95EE\u597D\uFF0C\u4FBF\u660E\u767D\u4E86\u2014\u2014\r\n       
    <b>\u524D\u65B9\uFF0C\u5373\u662F\u8D77\u70B9\uFF0C\u4EA6\u662F\u5F81\u9014\u3002</b>\u300D\r\n\r\n   
    \u300C\u597D\u50CF\u5B66\u4F1A\u4E86\u5343\u4E07\u79CD\u8BED\u8A00\uFF0C\u5374\u6709\u4E00\u5929\u4E0D\u5C0F\u5FC3\u78B0\u5230\u4E86
    Unity.\u300D\r\n\r\n    \u300C\u6211\u4E0D\u77E5\u9053\uFF0C\u4E5F\u4E0D\u60F3\u77E5\u9053\u8FD9\u6BB5\u5982\u8BD7\u5982\u753B\u7684\u4EE3\u7801\u8BE5\u5982\u4F55\u63CF\u8FF0\u3002\u300D\r\n\r\n   
    \u300C\u660E\u660E\uFF0C\u771F\u6B63\u7684\u5149\u660E\uFF0C\u5C31\u5728\u524D\u65B9\u554A\u3002\u300D\r\n\r\n   
    \u300C\u53EF\u662F\uFF0C\u6211\u7684\u6210\u5206\uFF0C\u9010\u6E10\u53D8\u5F97\u6BD4\u4E09\u785D\u57FA\u7532\u82EF\u8FD8\u8981\u590D\u6742\uFF08\uFF1F\u300D\r\n\r\n   
    \u300COI, Unity, AI, Math, Web\u300D\r\n\r\n    \u300C\u6211\u8BE5\u5728\u54EA\u91CC\u505C\u7559\uFF1F\u6211\u95EE\u6211\u81EA\u5DF1\u3002\u300D\r\n\r\n\r\n   
    \u867D\u7136\u6709\u7684 WiPhi \u6B7B\u4E86\uFF0C\u4F46\u4ED6\u8FD8\u6D3B\u7740\u3002\u2014\u2014\u9C81\u8FC5\r\n\r\n   
    \u8BA9\u6211\u4EEC\u795D\u5979\u4E00\u8DEF\u8D70\u597D\u3002\uFF08\u4E0D\u8981\u5F53\u771F\r\n\r\n   
    ---------- \u9E23\u8C22 ----------\r\n\u4F5C\u8005\u81EA\u5DF1\r\n\u4EE5\u53CA\u6240\u6709\u4E3A\u5F00\u53D1\u63D0\u4F9B\u8FC7\u5E2E\u52A9\u7684\u4EBA\r\n\r\n   
    And You!\r\n\r\n\r\n\r\n\r\n"
  m_enableAdvanceTextProcess: 0
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 01d539a5aca409a439b9279cb7cded02, type: 2}
  m_sharedMaterial: {fileID: -511392372416258626, guid: 01d539a5aca409a439b9279cb7cded02,
