{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "3d91ed5dcf7a4c2c993d19c1d990df37",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "GetViewDir (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1524.666748046875,
            "y": -134.6666717529297,
            "width": 220.0,
            "height": 280.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "7e102b6e03e74e62be789acc969e4014"
        },
        {
            "m_Id": "6ca8685dc6564eb0a48d7b39efe6ca67"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_NodeLOD": 0,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GetViewDir",
    "m_FunctionSource": "",
    "m_FunctionBody": "#include \"Packages/com.unity.render-pipelines.core/ShaderLibrary/SpaceTransforms.hlsl\"\r\n\r\nfloat4x4 invProjMatrix = UNITY_MATRIX_I_P;\r\nfloat4 clipPos = float4(uv.xy * 2.0 - 1.0, 1.0, 1.0);\r\nfloat4 viewPos = mul(invProjMatrix, clipPos);\r\nfloat3 viewVec = viewPos.xyz / viewPos.w;\r\n\r\n// 注意：不要重新声明 float3，直接使用输出参数 viewDir\r\nviewDir = mul((float3x3)UNITY_MATRIX_I_V, viewVec);\r\nviewDir = normalize(viewDir);"
}

