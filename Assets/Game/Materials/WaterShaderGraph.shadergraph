    "m_SourceType": 1,
    "m_FunctionName": "GetViewDir",
    "m_FunctionSource": "",
    "m_FunctionBody": "//float3 viewVector = mul(unity_CameraInvProjection, float4(uv.xy*2.0-1.0, 0, -1));\r\n\r\n//viewDir = mul(unity_CameraToWorld, viewVector);\r\n\r\n// #include \"Packages/com.unity.render-pipelines.core/ShaderLibrary/SpaceTransforms.hlsl\"\r\n\r\n// float4x4 invProjMatrix = UNITY_MATRIX_I_P;\r\n// float4 clipPos = float4(uv.xy * 2.0 - 1.0, 1.0, 1.0);\r\n// float4 viewPos = mul(invProjMatrix, clipPos);\r\n// float3 viewVec = viewPos.xyz / viewPos.w;\r\n\r\n// // 注意：不要重新声明 float3，直接使用输出参数 viewDir\r\n// viewDir = mul((float3x3)UNITY_MATRIX_I_V, viewVec);\r\n// viewDir = normalize(viewDir);\r\n\r\nviewDir = float3(0, 0, 0);"
}

